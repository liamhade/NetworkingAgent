# Copy to .env (gitignored) and fill in. On a host, set these in its dashboard instead.
# Full list and defaults: README.md (Settings) and docs/deploy/README.md.

# Required
ANTHROPIC_KEY=
# Google results via serper.dev (or SERPAPI_API_KEY for serpapi.com). Unset: local Chrome.
SERPER_API_KEY=

# Accounts (email + password, for emails you approve). Leave all three unset for local
# development: everyone is TEST_USER and no sign-in is asked for. Never deploy without them.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Your inbox: people email it from their own address to ask for access (shown publicly).
ACCESS_REQUEST_EMAIL=
# Your account email: always allowed in, and the only one that sees the Admin tab
# (whitelist + every user's LLM usage).
OWNER_EMAIL=

# Local development only: keep the sign-in page, but any email/password (even empty) signs in
# as TEST_USER, without Supabase. true/false; restart the backend to switch. Only works from
# localhost (refused behind a proxy), but never set it on a host.
LOCAL_DEV_MODE=false

# Optional: federal jobs (https://developer.usajobs.gov/apirequest)
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Optional tuning (the values shown are the defaults)
# LLM_MODEL=anthropic:claude-haiku-5-5
# MAX_CONCURRENT_SEARCHES=2
# DATABASE_DIR=./database
# COOKIE_SECURE=auto

# Search size
# MAX_COMPANIES=6
# PEOPLE_AUTO_COMPANIES=3
# PEOPLE_PER_COMPANY=3
# PEOPLE_SEARCH_N=5
# PEOPLE_SIMILAR_MAX_QUERIES=2
# PEOPLE_SIMILAR_PER_COMPANY=2
# ATS_MAX_BOARDS=6
# ATS_JOBS_PER_BOARD=4
# ATS_RESOLVE_LINKS=3
# USAJOBS_MAX_QUERIES=2
# USAJOBS_RESULTS=10
# LINKEDIN_MESSAGE_MAX_CHARS=300

# Job postings read in full: READ_POSTINGS for the results' write-up; READ_TIMEOUT_S caps how
# long a batch of reads may take (slower pages are skipped).
# READ_POSTINGS=2
# READ_POSTING_MAX_CHARS=4000
# READ_TIMEOUT_S=8

# Rescoring (off at 0): read the top N postings of each ranked company and score them again
# with their requirements in view, using RESCORE_MODEL. With Sonnet and N=2, about +$0.025
# and +10 s per search (docs/experience-fit/experiment.md).
# RESCORE_POSTINGS=0
# RESCORE_POSTING_MAX_CHARS=2500
# RESCORE_MODEL=anthropic:claude-sonnet-5-5
